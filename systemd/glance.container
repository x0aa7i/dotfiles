[Unit]
Description=Glance Personal Dashboard
After=network-online.target

[Container]
Image=docker.io/glanceapp/glance:latest
ContainerName=glance
Network=host
Environment=TZ=Africa/Casablanca
# The real folder: :z relabels for SELinux and does not follow the ~/.config/glance symlink
Volume=%h/dotfiles/glance:/app/config:z
Volume=/etc/localtime:/etc/localtime:ro
Volume=/:/host:ro
Volume=/mnt/backup:/host/mnt/backup:ro

[Service]
Restart=always

[Install]
WantedBy=default.target
