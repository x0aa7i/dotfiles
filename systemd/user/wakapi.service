[Unit]
Description=Wakapi
StartLimitIntervalSec=400
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/.local/share/wakapi
ExecStart=%h/.local/share/wakapi/wakapi --config %h/.local/share/wakapi/wakapi.yml

Environment=WAKAPI_PORT=3050
Environment=WAKAPI_PUBLIC_URL=http://localhost:3050

Restart=on-failure
RestartSec=90

[Install]
WantedBy=default.target
